{
  "name": "@deepseek-ai/dsh-remote-host-v3",
  "description": "Protected Host composition for DeepSeek Harness remote v3 relay routes",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mobile/remote-host-v3"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsc -b && tsdown --config tsdown.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-remote-api": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-remote-api": "workspace:*",
    "@deepseek-ai/dsh-remote-devices": "workspace:*",
    "@deepseek-ai/dsh-remote-gateway": "workspace:*",
    "@deepseek-ai/dsh-remote-wire": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-remote-devices": "workspace:*",
    "@deepseek-ai/dsh-remote-gateway": "workspace:*",
    "@deepseek-ai/dsh-remote-wire": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@types/ws": "^8.18.1"
  }
}
