{
  "name": "@deepseek-ai/dsh-pairing-protocol",
  "description": "Versioned validation and sequencing vocabulary for accountless encrypted mobile pairing",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/mobile/pairing-protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsc -b && tsdown --config tsdown.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
